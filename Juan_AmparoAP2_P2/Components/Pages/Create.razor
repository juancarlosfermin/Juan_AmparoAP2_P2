@page "/create"
@using Juan_AmparoAP2_P2.Services
@using Juan_AmparoAP2_P2.Models
@using Blazored.Toast.Services
@inject AsignacionesServices asignacionesServices
@inject estudiantesServices estudiantesServices
@inject TiposPuntosServices tiposPuntosServices
@inject NavigationManager navigationManager
@inject IToastService toastService
@rendermode InteractiveServer

<h3>Asignar Puntos</h3>

<EditForm Model="asignacion" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Fecha</label>
                    <InputDate class="form-control" @bind-Value="asignacion.Fecha" />
                    <ValidationMessage For="@(() => asignacion.Fecha)" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Estudiante</label>
                    <InputSelect class="form-select" @bind-Value="asignacion.EstudianteId">
                        <option value="0">Seleccione un estudiante...</option>
                        @foreach (var est in listaEstudiantes)
                        {
                            <option value="@est.EstudianteId">@est.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => asignacion.EstudianteId)" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Detalle de Puntos</h5>
        </div>
        <div class="card-body">
            <div class="row align-items-start">
                <div class="col-md-6 mb-3">
                    <label>Tipo de Punto</label>
                    <select class="form-select" value="@nuevoDetalle.TipoPuntoId" @onchange="OnTipoPuntoSeleccionado">
                        <option value="0">Seleccione un tipo...</option>
                        @foreach (var tipo in listaTiposActivos)
                        {
                            <option value="@tipo.TipoId">@tipo.Nombre (@tipo.ValorPuntos pts)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label>Cantidad de Puntos</label>
                    <InputNumber class="form-control" @bind-Value="nuevoDetalle.CantidadPuntos" readonly />
                </div>
                <div class="col-md-3 mb-3 mt-4">
                    <button type="button" class="btn btn-primary" @onclick="AgregarDetalle">Agregar</button>
                </div>
            </div>

            <table class="table table-bordered mt-3">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Puntos Otorgados</th>
                        <th>Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in asignacion.AsignacionesDetalle)
                    {
                        <tr>
                            <td>@ObtenerNombreTipoPunto(detalle.TipoPuntoId)</td>
                            <td>@detalle.CantidadPuntos</td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm" @onclick="(() => RemoverDetalle(detalle))">Remover</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <button type="submit" class="btn btn-primary" disabled="@guardando">Guardar Asignacion</button>
    <a href="/index" class="btn btn-secondary">Volver</a>
</EditForm>

@code {
    public AsignacionesPuntos asignacion { get; set; } = new AsignacionesPuntos();
    public AsignacionesPuntosDetalle nuevoDetalle { get; set; } = new AsignacionesPuntosDetalle();
    
    public List<Estudiantes> listaEstudiantes { get; set; } = new List<Estudiantes>();
    public List<TiposPuntos> listaTiposActivos { get; set; } = new List<TiposPuntos>();
    
    public bool guardando { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        listaEstudiantes = await estudiantesServices.ObtenerTodos();
        listaTiposActivos = await tiposPuntosServices.ObtenerActivos();
    }

    private void OnTipoPuntoSeleccionado(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idSeleccionado))
        {
            nuevoDetalle.TipoPuntoId = idSeleccionado;
            var tipo = listaTiposActivos.FirstOrDefault(t => t.TipoId == idSeleccionado);
            if (tipo != null)
            {
                nuevoDetalle.CantidadPuntos = tipo.ValorPuntos;
            }
        }
    }

    private string ObtenerNombreTipoPunto(int id)
    {
        var tipo = listaTiposActivos.FirstOrDefault(t => t.TipoId == id);
        return tipo != null ? tipo.Nombre : "Desconocido";
    }

    private void CalcularTotal()
    {
        asignacion.TotalPuntos = asignacion.AsignacionesDetalle.Sum(d => d.CantidadPuntos);
    }

    private void AgregarDetalle()
    {
        if (nuevoDetalle.TipoPuntoId > 0 && nuevoDetalle.CantidadPuntos > 0)
        {
            asignacion.AsignacionesDetalle.Add(new AsignacionesPuntosDetalle
            {
                TipoPuntoId = nuevoDetalle.TipoPuntoId,
                CantidadPuntos = nuevoDetalle.CantidadPuntos
            });
            CalcularTotal();
            nuevoDetalle = new AsignacionesPuntosDetalle();
        }
        else
        {
            toastService.ShowError("Por favor seleccione un tipo de punto valido");
        }
    }

    private void RemoverDetalle(AsignacionesPuntosDetalle detalle)
    {
        asignacion.AsignacionesDetalle.Remove(detalle);
        CalcularTotal();
    }

    private async Task Guardar()
    {
        if (asignacion.AsignacionesDetalle.Any())
        {
            guardando = true;
            CalcularTotal();
            if (await asignacionesServices.Guardar(asignacion))
            {
                toastService.ShowSuccess("Guardado correctamente");
                navigationManager.NavigateTo("/index");
            }
            else
            {
                toastService.ShowError("Error al guardar");
                guardando = false;
            }
        }
        else
        {
            toastService.ShowError("Debe registrar al menos un tipo de punto");
        }
    }
}
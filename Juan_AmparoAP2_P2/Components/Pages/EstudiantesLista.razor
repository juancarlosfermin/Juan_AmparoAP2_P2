@page "/estudiantes"
@using Juan_AmparoAP2_P2.Services
@using Juan_AmparoAP2_P2.Models
@using Blazored.Toast.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@inject estudiantesServices estudiantesServices
@inject IToastService toastService
@rendermode InteractiveServer

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">Balance de Puntos por Estudiante</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <QuickGrid Items="@lista.AsQueryable()" Pagination="@pagination" Class="table table-hover align-middle">
                <PropertyColumn Property="@(e => e.EstudianteId)" Title="ID" Sortable="true" />
                <PropertyColumn Property="@(e => e.Nombres)" Title="Nombre del Estudiante" Sortable="true" />
                <PropertyColumn Property="@(e => e.BalancePuntos)" Title="Total de Puntos Acumulados" Sortable="true" />
            </QuickGrid>
        </div>
        
        <div class="card-footer d-flex justify-content-between align-items-center">
            <div class="text-muted fw-bold">
                Cantidad: @lista.Count
            </div>
            <Paginator State="@pagination" />
        </div>
    </div>
</div>

@code {
    public List<Estudiantes> lista { get; set; } = new List<Estudiantes>();
    public List<Estudiantes> listaCompleta { get; set; } = new List<Estudiantes>();

    PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    protected override async Task OnInitializedAsync()
    {
        listaCompleta = await estudiantesServices.ObtenerTodos();
        lista = listaCompleta.ToList();
    }
}